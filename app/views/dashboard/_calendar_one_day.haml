.full_cal_display
  .section_heading
    - day_text = day == Date.today ? "Today's Calendar" : day.strftime("%d/%m/%Y")
    #{day_text}
  - today_box = boxes[day]
  - if today_box
    - today_box.get_alldays.each do |event|
      = render partial: 'calendar_one_event', :locals => { event: event, timed_key: nil }
    - timed = today_box.get_timed
    - timed.keys.sort.each do |key|
      = render partial: 'calendar_one_event', :locals => { event: timed[key], timed_key: key }